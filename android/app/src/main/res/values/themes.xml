<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- All black from the first frame; the immersive dial owns every gesture,
         so system swipe-to-dismiss is off (the side keys still go home/back). -->
    <style name="Theme.Omnitrix" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSwipeToDismiss">false</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_omnitrix</item>
    </style>
</resources>
